{
  "name": "@monoid-dev/split-pages",
  "version": "0.0.7",
  "private": false,
  "description": "Generate routing with code-splitting",
  "author": "Chenyu Wang <cwang592@usc.edu>",
  "repository": "https://github.com/MonoidDev/split-pages",
  "license": "MIT",
  "keywords": [
    "typescript"
  ],
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "require": "./dist/cjs/index.cjs",
    "import": "./dist/esm/index.mjs"
  },
  "bin": {
    "split-pages": "./dist/cjs/cli.cjs"
  },
  "scripts": {
    "cli": "pnpm ts src/cli.ts",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "clean": "rimraf dist",
    "ts": "esmo",
    "build": "pnpm clean && pnpm tsc && pnpm esbuild",
    "esbuild": "node esbuild.js",
    "prepare": "pnpm lint && pnpm build"
  },
  "devDependencies": {
    "@types/jest": "^26.0.21",
    "@types/node": "^15.0.1",
    "@types/yargs": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^4.19.0",
    "@typescript-eslint/parser": "^4.19.0",
    "esbuild": "^0.11.11",
    "esbuild-node-externals": "^1.3.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-airbnb-typescript": "^14.0.0",
    "eslint-config-next": "11.1.2",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.25.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "esmo": "^0.10.1",
    "jest": "^26.6.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^26.5.4",
    "typedoc": "^0.20.35",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "prettier": "^2.4.1",
    "walkdir": "^0.4.1",
    "yargs": "^17.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.9.0+sha512.60c18acd138bff695d339be6ad13f7e936eea6745660d4cc4a776d5247c540d0edee1a563695c183a66eb917ef88f2b4feb1fc25f32a7adcadc7aaf3438e99c1"
}
